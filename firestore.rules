rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'vaultixincometeam@outlook.com' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
    }

    // Users Collection: Private to owner or admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'balance', 'totalDeposits', 'totalInvestments', 'totalProfitLoss', 
          'referralEarnings', 'bonusBalance', 'role', 'accountStatus'
        ])
      );
      allow delete: if isAdmin();
    }

    // Transactions Collection: Private to owner and admin, or public approved/completed for ticker
    match /transactions/{txId} {
      allow read: if isAdmin() || 
        (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.status == 'APPROVED' || resource.data.status == 'COMPLETED'));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Investment Plans & Wallets Collections
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /wallets/{walletId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Diagnostics Collection
    match /_diagnostics/{docId} {
      allow read, write: if true;
    }
  }
}
